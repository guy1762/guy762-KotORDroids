    <descriptionHyperlinks>
		<HediffDef>guy762_SensorHediff_goto</HediffDef>
		
		<AlienRace.ThingDef_AlienRace>guy762_DroidRace_GOTO</AlienRace.ThingDef_AlienRace>
	</descriptionHyperlinks>
	<graphicData>
      <texPath>Items/droidtech/droidsensor_goto</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>2</Mass>
	  <MarketValue>18000</MarketValue>
	  
	  <WorkToMake>14000</WorkToMake>
    </statBases>
	<equippedStatOffsets>
		<PawnTrapSpringChance>-1</PawnTrapSpringChance>
		<MortarMissRadiusFactor>-0.5</MortarMissRadiusFactor>
		<ShootingAccuracyPawn>0.3</ShootingAccuracyPawn>
		<MeleeHitChance>0.3</MeleeHitChance>
	</equippedStatOffsets>
	
	<recipeMaker>
		<researchPrerequisite>guy762_ResearchKotOR_goto</researchPrerequisite>
		<skillRequirements>
			<Crafting>18</Crafting>
			<Intellectual>18</Intellectual>
		</skillRequirements>
	</recipeMaker>
	<costList>
		<Plasteel>20</Plasteel>
		<ComponentIndustrial>18</ComponentIndustrial>
		<ComponentSpacer>8</ComponentSpacer>
		<Gold>400</Gold>
		<KOTOR_UltraComponent>1</KOTOR_UltraComponent>
	</costList>
	
    <apparel>
	  <tags>
		<li>KotORDroidUpgrade_goto</li>
		<li>SWCPSpecificDroidTech_G0T0Sensor</li>
		<li>SWCPDroidApparelRestrictionTag_G0T0Only</li>
		<!-- <li>SWCPDroidApparelRestrictionTag_SensorTechSlot</li> -->
	  </tags>
	  <bodyPartGroups>
        <li>Eyes</li>
      </bodyPartGroups>
    </apparel>
	<tradeTags>
      <li>guy762TT_KotORLegendary</li>
    </tradeTags>
	<comps>
      <li Class="CompProperties_CauseHediff_Apparel">
        <hediff>guy762_SensorHediff_goto</hediff>
        <part>ABF_BodyPart_Synstruct_Core</part>
      </li>
    </comps>
  </ThingDef>
  
  <HediffDef>
    <defName>guy762_SensorHediff_goto</defName>
    <label>droid omniscience unit</label>
    <description>This sensor array has unique technology that allows the droid to basically know what is going on around it at all times.</description>
    <hediffClass>HediffWithComps</hediffClass>
    <stages>
      <li>
        <capMods>
          <li>
            <capacity>Sight</capacity>
            <offset>1</offset>
          </li>
		  <li>
            <capacity>Hearing</capacity>
            <offset>1</offset>
          </li>
        </capMods>
      </li>
    </stages>
    <comps>
      <li Class="HediffCompProperties_RemoveIfApparelDropped" />
    </comps>
    <isBad>false</isBad>
  </HediffDef>

  
  
</Defs>
