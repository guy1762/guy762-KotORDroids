<Defs>


  
  
  
  
  
  <ThingDef ParentName="guy762_DroidCraftableTech">
    <defName>guy762_DroidSensor_hk</defName>
    <label>droid assassination module</label>
    <description>Not much is known about the inner-workings of these modules, but one thing is for certain: they work.\n\nThis is a highly advanced piece of technology, and can only be equipped on the following droid models:</description>
    <descriptionHyperlinks>
		<AlienRace.ThingDef_AlienRace>guy762_DroidRace_HKseries</AlienRace.ThingDef_AlienRace>
		<AlienRace.ThingDef_AlienRace>guy762_DroidRace_HK50series</AlienRace.ThingDef_AlienRace>
		<AlienRace.ThingDef_AlienRace>guy762_DroidRace_HK51series</AlienRace.ThingDef_AlienRace>
	</descriptionHyperlinks>
	<graphicData>
      <texPath>Items/droidtech/droidsensor_hk</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>2</Mass>
	  <MarketValue>18000</MarketValue>
	  
	  <WorkToMake>20000</WorkToMake>
    </statBases>
	<equippedStatOffsets>
		<ShootingAccuracyPawn>0.9</ShootingAccuracyPawn>
		<MeleeHitChance>0.9</MeleeHitChance>
	</equippedStatOffsets>
	
	<recipeMaker>
		<researchPrerequisite>guy762_ResearchKotOR_hkequipment</researchPrerequisite>
		<skillRequirements>
			<Crafting>16</Crafting>
			<Intellectual>16</Intellectual>
		</skillRequirements>
	</recipeMaker>
	<costList>
		<Plasteel>20</Plasteel>
		<ComponentIndustrial>6</ComponentIndustrial>
		<ComponentSpacer>10</ComponentSpacer>
		<KOTOR_UltraComponent>1</KOTOR_UltraComponent>
	</costList>
	
    <apparel>
	  <tags>
		<li>KotORDroidUpgrade_hk</li>
		<li>SWCPSpecificDroidTech_HK47Sensor</li>
		<li>SWCPDroidApparelRestrictionTag_HK47Only</li>
		<!-- <li>SWCPDroidApparelRestrictionTag_SensorTechSlot</li> -->
	  </tags>
	  <bodyPartGroups>
        <li>Eyes</li>
      </bodyPartGroups>
    </apparel>
	<tradeTags>
      <li>guy762TT_KotORLegendary</li>
    </tradeTags>
  </ThingDef>
  
  
  <ThingDef ParentName="guy762_DroidCraftableTech">
    <defName>guy762_DroidSensor_goto</defName>
    <label>droid omniscience unit</label>
