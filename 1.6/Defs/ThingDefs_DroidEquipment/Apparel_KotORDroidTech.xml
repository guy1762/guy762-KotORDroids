  <ThingDef ParentName="guy762_DroidCraftableTech">
    <defName>guy762_DroidHardware_regen</defName>
    <label>droid self-sustaining unit</label>
    <description>By reprogramming its internal systems, this upgrade takes the droid's built-in diagnostic routines to the next step: self-repair. Through several, closely-guarded processes, the droid can actually sustain and repair itself, regardless of availability of repair kits.\n\nThis is a highly advanced piece of technology, and can only be equipped on the following droid models:</description>
    <descriptionHyperlinks>
		<AlienRace.ThingDef_AlienRace>guy762_DroidRace_T3series</AlienRace.ThingDef_AlienRace>
	</descriptionHyperlinks>
	<graphicData>
      <texPath>Items/droidtech/droidhardware_T3</texPath>
      <graphicClass>Graphic_Single</graphicClass>
    </graphicData>
    <statBases>
      <Mass>2</Mass>
	  <MarketValue>6000</MarketValue>
	  
	  <WorkToMake>12000</WorkToMake>
    </statBases>
	<equippedStatOffsets>
		<InjuryHealingFactor>0.3</InjuryHealingFactor>
	</equippedStatOffsets>
	
	<recipeMaker>
		<researchPrerequisite>guy762_ResearchKotOR_teethree</researchPrerequisite>
		<skillRequirements>
			<Intellectual>16</Intellectual>
		</skillRequirements>
	</recipeMaker>
	<costList>
		<Plasteel>20</Plasteel>
		<ComponentIndustrial>10</ComponentIndustrial>
		<ComponentSpacer>6</ComponentSpacer>
	</costList>
	
    <apparel>
	  <tags>
		<li>KotORDroidUpgrade_T3M4</li>
		<li>SWKotORSpecificDroidTech_T3M4RepairHardware</li>
	  </tags>
	  <bodyPartGroups>
        <li>guy762BG_Droid_Tech_hardware</li>
      </bodyPartGroups>
    </apparel>
	<tradeTags>
      <li>guy762TT_KotORElite</li>
	  <li>guy762TT_DroidUpgrades_rare</li>
    </tradeTags>
  </ThingDef>
  
  
